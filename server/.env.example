# Copy to .env and fill in. Never commit .env (SR-11).
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookstore
REDIS_URL=
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_COST=12
# Leave SMTP_URL empty to use the mail stub (messages are logged, not sent).
SMTP_URL=
MAIL_FROM=Online Bookstore <no-reply@bookstore.local>
LOG_LEVEL=info
COMMISSION_RATE=0.10
